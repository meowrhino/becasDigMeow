{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meowrhino-studio",
  "compatibility_date": "2026-05-07",
  // En git va solo el fuente: Cloudflare construye dist/ al publicar.
  "build": { "command": "node build-seo.js" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Un segundo Worker con lo mismo, para enseñar una rama en otro dominio sin
  // pisar el de siempre: `npx wrangler deploy --env com` (meowrhino.com).
  "env": {
    "com": {
      "name": "meowrhino-com",
      // El dominio era del Worker meowrhino-com-redirect (301 a .studio), que
      // sigue existiendo sin dominio: para deshacer, quitar estas rutas y
      // volver a ponérselo a él.
      "routes": [
        { "pattern": "meowrhino.com", "custom_domain": true },
        { "pattern": "www.meowrhino.com", "custom_domain": true }
      ],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
      }
    }
  }
}
